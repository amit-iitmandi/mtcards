{
  "name": "server",
  "version": "1.0.0",
  "description": "Add Data",
  "main": "server.js",
  "scripts": {
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "server": "node --watch server.js",
    "start": "node server.js",
    "test:security": "node --test tests/*.test.js",
    "test:integration": "node --test integration/*.test.js",
    "test": "npm run test:security && npm run test:integration",
    "scan:secrets": "node scripts/scan-secrets.js"
  },
  "author": "Amit",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
